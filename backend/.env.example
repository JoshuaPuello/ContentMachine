FAL_API_KEY=
REPLICATE_API_KEY=
GEMINI_API_KEY=
PORT=3001

# ACE-Step cloud sound design. Generated ten-second source files are analyzed,
# trimmed to the real event, normalized, and aligned by detected onset.
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_SFX_MODEL=eleven_text_to_sound_v2
ELEVENLABS_SFX_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_SFX_PROMPT_INFLUENCE=0.85
DIRECTOR_SFX_PROVIDER=elevenlabs

ACESTEP_API_BASE_URL=https://api.acemusic.ai
ACESTEP_API_KEY=
ACESTEP_MODEL=acemusic/acestep-v1.5-turbo
ACESTEP_INFERENCE_STEPS=12
ACESTEP_GUIDANCE_SCALE=7

# Vertex image generation. ContentMachine owns this configuration independently.
# For local use, credentials paths may be absolute or relative to backend/.
# For deployment, use *_CREDENTIALS_JSON with raw or base64 Google credential JSON.
USE_VERTEX_AI=false
VERTEX_LOCATION=global
VERTEX_IMAGE_RPM=2
VERTEX_IMAGE_ACCOUNTS=main,alt1,alt2
VERTEX_MAIN_PROJECT=
VERTEX_MAIN_CREDENTIALS=
# VERTEX_MAIN_CREDENTIALS_JSON=
VERTEX_MAIN_IMAGE_RPM=2
VERTEX_ALT1_PROJECT=
VERTEX_ALT1_CREDENTIALS=
# VERTEX_ALT1_CREDENTIALS_JSON=
VERTEX_ALT1_IMAGE_RPM=2
VERTEX_ALT2_PROJECT=
VERTEX_ALT2_CREDENTIALS=
# VERTEX_ALT2_CREDENTIALS_JSON=
VERTEX_ALT2_IMAGE_RPM=2

# Shared StoryForge media-worker broker (server-side only).
MEDIA_BROKER_URL=https://storyforge.example.com
MEDIA_BROKER_PRODUCER_ID=content-machine
MEDIA_BROKER_PRODUCER_TOKEN=
MEDIA_BROKER_PROTOCOL_VERSION=1
MEDIA_BROKER_REQUEST_TIMEOUT_MS=30000
MEDIA_BROKER_POLL_INTERVAL_MS=5000
MEDIA_BROKER_PROJECT_CONCURRENCY=4
# Comma-separated exact signed-upload hosts. Use the account-specific R2 host.
MEDIA_BROKER_UPLOAD_HOSTS=
